# Copy to .env (gitignored) and fill in. Never commit .env.

# Claude API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gemini API key from https://aistudio.google.com/apikey (free tier works)
GEMINI_API_KEY=

# Optional tracing to Arize Phoenix (run `phoenix serve` first; pip install -e ".[trace]")
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
