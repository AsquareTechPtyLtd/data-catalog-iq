# Copy to .env (gitignored) and fill in. Never commit .env.

# Claude API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gemini API key from https://aistudio.google.com/apikey (free tier works)
GEMINI_API_KEY=

# Optional tracing to Arize Phoenix (run `phoenix serve` first; pip install -e ".[trace]")
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Names and emails become tokens before LLM calls and in traces (on unless set to off).
# TRACE_REDACTION=off gives readable traces for local debugging.
# REDACTION=on
# TRACE_REDACTION=on

# Limits (defaults shown). Each agent run and each routing has a time and token budget;
# evals use the same budgets. The LLM endpoints allow MAX_IN_FLIGHT requests at once
# (503 beyond) and RATE_LIMIT_PER_MINUTE per client IP with bursts of RATE_LIMIT_BURST (429 beyond).
# AGENT_BUDGET_SECONDS=60
# AGENT_BUDGET_TOKENS=100000
# ROUTER_BUDGET_SECONDS=20
# ROUTER_BUDGET_TOKENS=30000
# MAX_IN_FLIGHT=4
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_BURST=5

# Catalog freshness (defaults shown). Answers warn, never refuse, once the oldest source
# export is older than CATALOG_MAX_AGE_HOURS. Ingestion refuses to publish a build that lost
# more than INGEST_MAX_TABLE_DROP of the tables (scripts/ingest_catalog.py --force overrides).
# CATALOG_MAX_AGE_HOURS=168
# INGEST_MAX_TABLE_DROP=0.2
